{
	"private": true,
	"type": "module",
	"name": "@drupflare/dashboard",
	"version": "1.0.0",
	"scripts": {
		"postinstall": "nuxt prepare",
		"dev": "nuxt dev",
		"build": "nuxt build",
		"build:test": "NUXT_TEST_BUILD=1 nuxt build",
		"typecheck": "nuxt typecheck && vue-tsc --noEmit -p tests/unit/tsconfig.json && vue-tsc --noEmit -p tsconfig.other.json && tsc -p engine/tsconfig.json && tsc -p dispatch/tsconfig.json",
		"test:unit": "vitest run --passWithNoTests && vitest run -c vitest.node.config.ts tests/unit --passWithNoTests",
		"test:node": "vitest run -c vitest.node.config.ts tests/unit --passWithNoTests",
		"test:bindings": "vitest run -c vitest.node.config.ts tests/bindings --passWithNoTests",
		"check:wrangler": "bun scripts/check-wrangler.ts",
		"sync:corpus": "bun scripts/sync-corpus.ts",
		"gen:permissions": "bun scripts/gen-permissions.ts",
		"gen:catalogue": "bun scripts/gen-catalogue.ts",
		"gen:contracts": "bun scripts/gen-contracts.ts",
		"gen:effort": "bun scripts/gen-effort.ts",
		"gen:openapi": "bun --tsconfig-override tests/tsconfig.json scripts/gen-openapi.ts",
		"sync:contracts": "bun scripts/sync-contracts.ts",
		"prettier": "prettier --write .",
		"prettier:check": "prettier --check .",
		"prepare": "husky"
	},
	"dependencies": {
		"@drupflare/spool": "^0.2.0",
		"@drupflare/untarl": "^0.1.0",
		"@drupflare/workforce": "^0.2.0",
		"@earth-app/collegedb": "^1.4.0",
		"@iconify-json/lucide": "^1.2.151",
		"@internationalized/date": "^3.12.4",
		"@nuxt/content": "^3.16.2",
		"@nuxt/hints": "^1.1.5",
		"@nuxt/icon": "^2.6.1",
		"@nuxt/image": "^2.2.0",
		"@nuxt/kit": "^4.6.2",
		"@nuxt/ui": "^4.12.0",
		"@nuxthub/core": "^0.10.11",
		"@nuxtjs/robots": "^7.0.2",
		"@nuxtjs/sitemap": "^9.1.0",
		"@nuxtjs/turnstile": "^1.1.3",
		"@pinia/nuxt": "^1.0.3",
		"@simplewebauthn/browser": "^14.0.0",
		"@simplewebauthn/server": "^14.0.3",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/charts": "^1.4.0",
		"@types/luxon": "^3.7.6",
		"@vueuse/core": "^15.0.0",
		"@vueuse/nuxt": "^15.0.0",
		"arctic": "^3.7.0",
		"drizzle-orm": "^0.45.4",
		"edgeport": "^1.0.6",
		"jose": "^6.2.13",
		"luxon": "^3.7.2",
		"nuxt": "^4.6.2",
		"nuxt-schema-org": "^7.0.1",
		"pinia": "^4.1.0",
		"reflect-metadata": "^0.2.2",
		"stripe": "^23.0.1",
		"swagger-ui-dist": "5.34.1",
		"tailwindcss": "^4.3.3",
		"vue": "^3.5.44",
		"vue-router": "^5.4.0",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261104.1",
		"@codecov/nuxt-plugin": "^2.0.1",
		"@libsql/client": "^0.18.0",
		"@nuxt/test-utils": "^4.3.4",
		"@playwright/test": "^1.64.1",
		"@vitest/coverage-v8": "^5.0.5",
		"@vue/test-utils": "^2.5.1",
		"drizzle-kit": "^0.31.11",
		"happy-dom": "^21.0.4",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-sh": "^0.20.2",
		"typescript": "5",
		"vitest": "^5.0.5",
		"vue-tsc": "^3.3.14",
		"wrangler": "^4.152.0"
	},
	"lint-staged": {
		"*.{ts,js,mjs,css,md,json,jsonc}": "prettier --write"
	}
}
