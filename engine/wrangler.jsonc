{
	"name": "drupflare-engine",
	"main": "src/index.ts",
	"tsconfig": "./tsconfig.json",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"triggers": { "crons": ["*/15 * * * *"] },
	"d1_databases": [{ "binding": "DB", "database_name": "drupflare-dashboard-db" }],
	"kv_namespaces": [{ "binding": "KV" }, { "binding": "HOSTS_KV" }],
	"r2_buckets": [{ "binding": "BLOB", "bucket_name": "drupflare-dashboard-blob" }],
	"durable_objects": {
		"bindings": [
			{ "name": "SITE_LEASE", "class_name": "SiteLease" },
			{ "name": "SITE_AUTH", "class_name": "SiteAuth", "script_name": "drupflare-dispatch" },
			{ "name": "NAMES", "class_name": "Names", "script_name": "drupflare-dispatch" },
			{
				"name": "USAGE_COUNTER",
				"class_name": "UsageCounter",
				"script_name": "drupflare-dispatch"
			},
			{ "name": "NODE_SESSION", "class_name": "NodeSession" },
			{ "name": "API_BUDGET", "class_name": "ApiBudget" }
		]
	},
	"workflows": [
		{ "name": "site-create", "binding": "SITE_CREATE", "class_name": "SiteCreate" },
		{ "name": "site-upgrade", "binding": "SITE_UPGRADE", "class_name": "SiteUpgrade" },
		{ "name": "site-delete", "binding": "SITE_DELETE", "class_name": "SiteDelete" },
		{ "name": "site-purge", "binding": "SITE_PURGE", "class_name": "SitePurge" },
		{ "name": "site-cleanup", "binding": "SITE_CLEANUP", "class_name": "SiteCleanup" },
		{ "name": "site-auth-state", "binding": "SITE_AUTH_STATE", "class_name": "SiteAuthState" },
		{ "name": "site-adopt", "binding": "SITE_ADOPT", "class_name": "SiteAdopt" },
		{ "name": "site-repair", "binding": "SITE_REPAIR", "class_name": "SiteRepair" },
		{ "name": "backup-create", "binding": "BACKUP_CREATE", "class_name": "BackupCreate" },
		{ "name": "backup-restore", "binding": "BACKUP_RESTORE", "class_name": "BackupRestore" },
		{ "name": "backup-verify", "binding": "BACKUP_VERIFY", "class_name": "BackupVerify" },
		{ "name": "access-sync", "binding": "ACCESS_SYNC", "class_name": "AccessSync" },
		{ "name": "env-create", "binding": "ENV_CREATE", "class_name": "EnvCreate" },
		{ "name": "env-delete", "binding": "ENV_DELETE", "class_name": "EnvDelete" },
		{ "name": "site-pitr", "binding": "SITE_PITR", "class_name": "SitePitr" },
		{ "name": "config-apply", "binding": "CONFIG_APPLY", "class_name": "ConfigApply" },
		{ "name": "module-install", "binding": "MODULE_INSTALL", "class_name": "ModuleInstall" },
		{ "name": "module-enable", "binding": "MODULE_ENABLE", "class_name": "ModuleEnable" },
		{ "name": "modify-apply", "binding": "MODIFY_APPLY", "class_name": "ModifyApply" },
		{ "name": "module-remove", "binding": "MODULE_REMOVE", "class_name": "ModuleRemove" },
		{ "name": "theme-default", "binding": "THEME_DEFAULT", "class_name": "ThemeDefault" },
		{
			"name": "migration-cutover",
			"binding": "MIGRATION_CUTOVER",
			"class_name": "MigrationCutover"
		},
		{ "name": "site-import", "binding": "SITE_IMPORT", "class_name": "SiteImport" },
		{ "name": "import-survey", "binding": "IMPORT_SURVEY", "class_name": "ImportSurvey" },
		{ "name": "estate-assess", "binding": "ESTATE_ASSESS", "class_name": "EstateAssess" },
		{ "name": "git-pull", "binding": "GIT_PULL", "class_name": "GitPull" },
		{ "name": "domain-attach", "binding": "DOMAIN_ATTACH", "class_name": "DomainAttach" },
		{
			"name": "node-site-create",
			"binding": "NODE_SITE_CREATE",
			"class_name": "NodeSiteCreate"
		},
		{ "name": "site-rollback", "binding": "SITE_ROLLBACK", "class_name": "SiteRollback" },
		{ "name": "release-ring", "binding": "RELEASE_RING", "class_name": "ReleaseRing" },
		{ "name": "template-build", "binding": "TEMPLATE_BUILD", "class_name": "TemplateBuild" },
		{ "name": "site-transfer", "binding": "SITE_TRANSFER", "class_name": "SiteTransfer" }
	],
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["SiteLease"] },
		{ "tag": "v2", "new_sqlite_classes": ["NodeSession"] },
		{ "tag": "v4", "new_sqlite_classes": ["ApiBudget"] }
	],
	"vars": {
		"DISPATCH_NAMESPACE": "drupflare-prod",
		"RELEASES_URL": "https://cdn.drupflare.com/payloads/managed/",
		"LEASE_TTL_MS": "600000",
		"ASSET_CHUNK_BYTES": "8388608",
		"LIMIT_MODULE_BYTES": "67108864",
		"LIMIT_TOTAL_BYTES": "67108864",
		"LIMIT_ASSET_BYTES": "26214400",
		"LIMIT_ASSETS": "20000",
		"SITE_TIMEOUT_MS": "60000",
		"PENDING_SECRET_TTL_MS": "86400000"
	},
	"env": {
		"stage": {
			"name": "drupflare-engine-stage",
			"triggers": { "crons": ["*/15 * * * *"] },
			"d1_databases": [{ "binding": "DB", "database_name": "drupflare-dashboard-db-stage" }],
			"kv_namespaces": [{ "binding": "KV" }, { "binding": "HOSTS_KV" }],
			"r2_buckets": [{ "binding": "BLOB", "bucket_name": "drupflare-dashboard-blob-stage" }],
			"durable_objects": {
				"bindings": [
					{ "name": "SITE_LEASE", "class_name": "SiteLease" },
					{
						"name": "SITE_AUTH",
						"class_name": "SiteAuth",
						"script_name": "drupflare-dispatch-stage"
					},
					{
						"name": "NAMES",
						"class_name": "Names",
						"script_name": "drupflare-dispatch-stage"
					},
					{
						"name": "USAGE_COUNTER",
						"class_name": "UsageCounter",
						"script_name": "drupflare-dispatch-stage"
					},
					{ "name": "NODE_SESSION", "class_name": "NodeSession" },
					{ "name": "JOB_RUNNER", "class_name": "JobRunner" },
					{ "name": "API_BUDGET", "class_name": "ApiBudget" }
				]
			},
			"workflows": [
				{
					"name": "site-create-stage",
					"binding": "SITE_CREATE",
					"class_name": "SiteCreate"
				},
				{
					"name": "site-upgrade-stage",
					"binding": "SITE_UPGRADE",
					"class_name": "SiteUpgrade"
				},
				{
					"name": "site-delete-stage",
					"binding": "SITE_DELETE",
					"class_name": "SiteDelete"
				},
				{ "name": "site-purge-stage", "binding": "SITE_PURGE", "class_name": "SitePurge" },
				{
					"name": "site-cleanup-stage",
					"binding": "SITE_CLEANUP",
					"class_name": "SiteCleanup"
				},
				{
					"name": "site-auth-state-stage",
					"binding": "SITE_AUTH_STATE",
					"class_name": "SiteAuthState"
				},
				{
					"name": "site-adopt-stage",
					"binding": "SITE_ADOPT",
					"class_name": "SiteAdopt"
				},
				{
					"name": "site-repair-stage",
					"binding": "SITE_REPAIR",
					"class_name": "SiteRepair"
				},
				{
					"name": "backup-create-stage",
					"binding": "BACKUP_CREATE",
					"class_name": "BackupCreate"
				},
				{
					"name": "backup-restore-stage",
					"binding": "BACKUP_RESTORE",
					"class_name": "BackupRestore"
				},
				{
					"name": "backup-verify-stage",
					"binding": "BACKUP_VERIFY",
					"class_name": "BackupVerify"
				},
				{
					"name": "access-sync-stage",
					"binding": "ACCESS_SYNC",
					"class_name": "AccessSync"
				},
				{ "name": "env-create-stage", "binding": "ENV_CREATE", "class_name": "EnvCreate" },
				{ "name": "env-delete-stage", "binding": "ENV_DELETE", "class_name": "EnvDelete" },
				{ "name": "site-pitr-stage", "binding": "SITE_PITR", "class_name": "SitePitr" },
				{
					"name": "config-apply-stage",
					"binding": "CONFIG_APPLY",
					"class_name": "ConfigApply"
				},
				{
					"name": "module-install-stage",
					"binding": "MODULE_INSTALL",
					"class_name": "ModuleInstall"
				},
				{
					"name": "module-enable-stage",
					"binding": "MODULE_ENABLE",
					"class_name": "ModuleEnable"
				},
				{
					"name": "modify-apply-stage",
					"binding": "MODIFY_APPLY",
					"class_name": "ModifyApply"
				},
				{
					"name": "module-remove-stage",
					"binding": "MODULE_REMOVE",
					"class_name": "ModuleRemove"
				},
				{
					"name": "theme-default-stage",
					"binding": "THEME_DEFAULT",
					"class_name": "ThemeDefault"
				},
				{
					"name": "migration-cutover-stage",
					"binding": "MIGRATION_CUTOVER",
					"class_name": "MigrationCutover"
				},
				{
					"name": "site-import-stage",
					"binding": "SITE_IMPORT",
					"class_name": "SiteImport"
				},
				{
					"name": "import-survey-stage",
					"binding": "IMPORT_SURVEY",
					"class_name": "ImportSurvey"
				},
				{
					"name": "estate-assess-stage",
					"binding": "ESTATE_ASSESS",
					"class_name": "EstateAssess"
				},
				{ "name": "git-pull-stage", "binding": "GIT_PULL", "class_name": "GitPull" },
				{
					"name": "domain-attach-stage",
					"binding": "DOMAIN_ATTACH",
					"class_name": "DomainAttach"
				},
				{
					"name": "node-site-create-stage",
					"binding": "NODE_SITE_CREATE",
					"class_name": "NodeSiteCreate"
				},
				{
					"name": "site-rollback-stage",
					"binding": "SITE_ROLLBACK",
					"class_name": "SiteRollback"
				},
				{
					"name": "release-ring-stage",
					"binding": "RELEASE_RING",
					"class_name": "ReleaseRing"
				},
				{
					"name": "template-build-stage",
					"binding": "TEMPLATE_BUILD",
					"class_name": "TemplateBuild"
				},
				{
					"name": "site-transfer-stage",
					"binding": "SITE_TRANSFER",
					"class_name": "SiteTransfer"
				}
			],
			"containers": [
				{
					"class_name": "JobRunner",
					"scheduling_policy": "durable_object",
					"images": {
						"runner": {
							"dockerfile": "./src/containers/image/Dockerfile",
							"build_context": "./src/containers/image"
						}
					}
				}
			],
			"migrations": [
				{ "tag": "v1", "new_sqlite_classes": ["SiteLease"] },
				{ "tag": "v2", "new_sqlite_classes": ["NodeSession"] },
				{ "tag": "v3", "new_sqlite_classes": ["JobRunner"] },
				{ "tag": "v4", "new_sqlite_classes": ["ApiBudget"] }
			],
			"vars": {
				"DISPATCH_NAMESPACE": "drupflare-stage",
				"RELEASES_URL": "https://cdn.drupflare.com/payloads/managed/",
				"LEASE_TTL_MS": "600000",
				"ASSET_CHUNK_BYTES": "8388608",
				"LIMIT_MODULE_BYTES": "67108864",
				"LIMIT_TOTAL_BYTES": "67108864",
				"LIMIT_ASSET_BYTES": "26214400",
				"LIMIT_ASSETS": "20000",
				"SITE_TIMEOUT_MS": "60000",
				"PENDING_SECRET_TTL_MS": "86400000"
			}
		}
	}
}
