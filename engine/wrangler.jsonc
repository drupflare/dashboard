{
	"name": "drupflare-engine",
	"main": "src/index.ts",
	"tsconfig": "./tsconfig.json",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"triggers": { "crons": ["*/15 * * * *"] },
	"d1_databases": [{ "binding": "DB", "database_name": "drupflare-dashboard-db" }],
	"kv_namespaces": [{ "binding": "KV" }, { "binding": "HOSTS_KV" }],
	"r2_buckets": [{ "binding": "BLOB", "bucket_name": "drupflare-dashboard-blob" }],
	"durable_objects": {
		"bindings": [
			{ "name": "SITE_LEASE", "class_name": "SiteLease" },
			{ "name": "SITE_AUTH", "class_name": "SiteAuth", "script_name": "drupflare-dispatch" },
			{ "name": "NAMES", "class_name": "Names", "script_name": "drupflare-dispatch" },
			{ "name": "NODE_SESSION", "class_name": "NodeSession" }
		]
	},
	"workflows": [
		{ "name": "site-create", "binding": "SITE_CREATE", "class_name": "SiteCreate" },
		{ "name": "site-upgrade", "binding": "SITE_UPGRADE", "class_name": "SiteUpgrade" },
		{ "name": "site-delete", "binding": "SITE_DELETE", "class_name": "SiteDelete" },
		{ "name": "site-purge", "binding": "SITE_PURGE", "class_name": "SitePurge" },
		{ "name": "site-cleanup", "binding": "SITE_CLEANUP", "class_name": "SiteCleanup" },
		{ "name": "site-adopt", "binding": "SITE_ADOPT", "class_name": "SiteAdopt" },
		{ "name": "backup-create", "binding": "BACKUP_CREATE", "class_name": "BackupCreate" },
		{ "name": "backup-restore", "binding": "BACKUP_RESTORE", "class_name": "BackupRestore" },
		{
			"name": "migration-cutover",
			"binding": "MIGRATION_CUTOVER",
			"class_name": "MigrationCutover"
		},
		{ "name": "site-import", "binding": "SITE_IMPORT", "class_name": "SiteImport" },
		{ "name": "import-survey", "binding": "IMPORT_SURVEY", "class_name": "ImportSurvey" },
		{ "name": "estate-assess", "binding": "ESTATE_ASSESS", "class_name": "EstateAssess" },
		{ "name": "git-pull", "binding": "GIT_PULL", "class_name": "GitPull" },
		{ "name": "domain-attach", "binding": "DOMAIN_ATTACH", "class_name": "DomainAttach" },
		{
			"name": "node-site-create",
			"binding": "NODE_SITE_CREATE",
			"class_name": "NodeSiteCreate"
		}
	],
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["SiteLease"] },
		{ "tag": "v2", "new_sqlite_classes": ["NodeSession"] }
	],
	"vars": {
		"DISPATCH_NAMESPACE": "drupflare-prod",
		"RELEASES_URL": "https://cdn.drupflare.com/payloads/managed/",
		"LEASE_TTL_MS": "600000",
		"ASSET_CHUNK_BYTES": "8388608",
		"LIMIT_MODULE_BYTES": "67108864",
		"LIMIT_TOTAL_BYTES": "67108864",
		"LIMIT_ASSET_BYTES": "26214400",
		"LIMIT_ASSETS": "20000",
		"SITE_TIMEOUT_MS": "60000",
		"PENDING_SECRET_TTL_MS": "86400000"
	},
	"env": {
		"stage": {
			"name": "drupflare-engine-stage",
			"triggers": { "crons": ["*/15 * * * *"] },
			"d1_databases": [{ "binding": "DB", "database_name": "drupflare-dashboard-db-stage" }],
			"kv_namespaces": [{ "binding": "KV" }, { "binding": "HOSTS_KV" }],
			"r2_buckets": [{ "binding": "BLOB", "bucket_name": "drupflare-dashboard-blob-stage" }],
			"durable_objects": {
				"bindings": [
					{ "name": "SITE_LEASE", "class_name": "SiteLease" },
					{
						"name": "SITE_AUTH",
						"class_name": "SiteAuth",
						"script_name": "drupflare-dispatch-stage"
					},
					{
						"name": "NAMES",
						"class_name": "Names",
						"script_name": "drupflare-dispatch-stage"
					},
					{ "name": "NODE_SESSION", "class_name": "NodeSession" }
				]
			},
			"workflows": [
				{
					"name": "site-create-stage",
					"binding": "SITE_CREATE",
					"class_name": "SiteCreate"
				},
				{
					"name": "site-upgrade-stage",
					"binding": "SITE_UPGRADE",
					"class_name": "SiteUpgrade"
				},
				{
					"name": "site-delete-stage",
					"binding": "SITE_DELETE",
					"class_name": "SiteDelete"
				},
				{ "name": "site-purge-stage", "binding": "SITE_PURGE", "class_name": "SitePurge" },
				{
					"name": "site-cleanup-stage",
					"binding": "SITE_CLEANUP",
					"class_name": "SiteCleanup"
				},
				{
					"name": "site-adopt-stage",
					"binding": "SITE_ADOPT",
					"class_name": "SiteAdopt"
				},
				{
					"name": "backup-create-stage",
					"binding": "BACKUP_CREATE",
					"class_name": "BackupCreate"
				},
				{
					"name": "backup-restore-stage",
					"binding": "BACKUP_RESTORE",
					"class_name": "BackupRestore"
				},
				{
					"name": "migration-cutover-stage",
					"binding": "MIGRATION_CUTOVER",
					"class_name": "MigrationCutover"
				},
				{
					"name": "site-import-stage",
					"binding": "SITE_IMPORT",
					"class_name": "SiteImport"
				},
				{
					"name": "import-survey-stage",
					"binding": "IMPORT_SURVEY",
					"class_name": "ImportSurvey"
				},
				{
					"name": "estate-assess-stage",
					"binding": "ESTATE_ASSESS",
					"class_name": "EstateAssess"
				},
				{ "name": "git-pull-stage", "binding": "GIT_PULL", "class_name": "GitPull" },
				{
					"name": "domain-attach-stage",
					"binding": "DOMAIN_ATTACH",
					"class_name": "DomainAttach"
				},
				{
					"name": "node-site-create-stage",
					"binding": "NODE_SITE_CREATE",
					"class_name": "NodeSiteCreate"
				}
			],
			"migrations": [
				{ "tag": "v1", "new_sqlite_classes": ["SiteLease"] },
				{ "tag": "v2", "new_sqlite_classes": ["NodeSession"] }
			],
			"vars": {
				"DISPATCH_NAMESPACE": "drupflare-stage",
				"RELEASES_URL": "https://cdn.drupflare.com/payloads/managed/",
				"LEASE_TTL_MS": "600000",
				"ASSET_CHUNK_BYTES": "8388608",
				"LIMIT_MODULE_BYTES": "67108864",
				"LIMIT_TOTAL_BYTES": "67108864",
				"LIMIT_ASSET_BYTES": "26214400",
				"LIMIT_ASSETS": "20000",
				"SITE_TIMEOUT_MS": "60000",
				"PENDING_SECRET_TTL_MS": "86400000"
			}
		}
	}
}
