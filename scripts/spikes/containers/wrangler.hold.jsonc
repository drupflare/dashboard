{
	"name": "drupflare-spike-hold",
	"main": "src/entry.js",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"containers": [
		{
			"class_name": "JobRunner",
			"scheduling_policy": "durable_object",
			"images": {
				"runner": {
					"dockerfile": "./Dockerfile.hold",
					"build_context": "../../../engine/src/containers/image"
				}
			}
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "JOB_RUNNER", "class_name": "JobRunner" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["JobRunner"] }],
	"r2_buckets": [{ "binding": "BLOB", "bucket_name": "spike-hold" }]
}
