{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"contract": "templates",
	"version": "1.0",
	"schemas": {
		"templateManifest": {
			"type": "object",
			"properties": {
				"v": { "type": "number", "const": 1 },
				"slug": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$" },
				"name": { "type": "string", "minLength": 1, "maxLength": 100 },
				"version": { "type": "string", "minLength": 1, "maxLength": 64 },
				"description": { "type": "string", "maxLength": 500 },
				"build": {
					"type": "object",
					"properties": {
						"command": {
							"anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
						},
						"output": { "type": "string", "minLength": 1 }
					},
					"required": ["command", "output"],
					"additionalProperties": false
				},
				"entry": { "type": "string", "minLength": 1 },
				"compatibilityDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
				"compatibilityFlags": { "type": "array", "items": { "type": "string" } },
				"bindings": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"type": {
								"type": "string",
								"enum": ["d1", "kv", "r2", "durable_object", "queue", "ai"]
							},
							"name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
						},
						"required": ["type", "name"],
						"additionalProperties": false
					}
				},
				"secrets": {
					"type": "array",
					"items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
				},
				"discovery": { "type": "boolean" }
			},
			"required": [
				"v",
				"slug",
				"name",
				"version",
				"description",
				"build",
				"entry",
				"compatibilityDate",
				"compatibilityFlags",
				"bindings",
				"secrets",
				"discovery"
			],
			"additionalProperties": false
		}
	}
}
