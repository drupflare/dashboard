{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"contract": "sites",
	"version": "1.0",
	"schemas": {
		"site": {
			"type": "object",
			"properties": {
				"id": { "type": "string", "pattern": "^site_[0-9a-z]{8,40}$" },
				"orgId": { "type": "string", "pattern": "^org_[0-9a-z]{8,40}$" },
				"name": { "type": "string", "minLength": 1, "maxLength": 100 },
				"kind": {
					"type": "string",
					"enum": ["drupal", "nuxtpress", "smoke", "mylora", "custom"]
				},
				"plane": { "type": "string", "enum": ["managed", "self-managed", "self-hosted"] },
				"state": {
					"type": "string",
					"enum": ["active", "suspended", "tombstoned", "purge-eligible", "deleted"]
				},
				"ring": { "type": "string", "enum": ["R0", "R1", "R2", "R3", "R4", "R5"] },
				"primaryHostname": {
					"anyOf": [
						{
							"type": "string",
							"maxLength": 253,
							"pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
						},
						{ "type": "null" }
					]
				},
				"hostnames": {
					"type": "array",
					"items": {
						"type": "string",
						"maxLength": 253,
						"pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
					}
				},
				"createdAt": {
					"type": "string",
					"format": "date-time",
					"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time",
					"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
				}
			},
			"required": [
				"id",
				"orgId",
				"name",
				"kind",
				"plane",
				"state",
				"ring",
				"primaryHostname",
				"hostnames",
				"createdAt",
				"updatedAt"
			],
			"additionalProperties": false
		}
	}
}
