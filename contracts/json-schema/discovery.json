{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"contract": "discovery",
	"version": "1.0",
	"schemas": {
		"xUi": {
			"type": "object",
			"properties": {
				"group": { "type": "string", "minLength": 1 },
				"permission": {
					"type": "string",
					"enum": [
						"runtime",
						"content",
						"security",
						"integrations",
						"appearance",
						"access"
					]
				},
				"widget": { "type": "string", "minLength": 1 },
				"planGate": { "type": "string", "minLength": 1 },
				"danger": { "type": "boolean" },
				"docLink": { "type": "string", "format": "uri" }
			},
			"required": ["group", "permission"],
			"additionalProperties": false
		},
		"capability": {
			"type": "object",
			"properties": {
				"id": { "type": "string", "minLength": 1 },
				"state": {
					"type": "string",
					"enum": ["enabled", "disabled", "unavailable", "degraded"]
				},
				"reason": { "type": ["string", "null"] }
			},
			"required": ["id", "state", "reason"],
			"additionalProperties": false
		},
		"route": {
			"type": "object",
			"properties": {
				"id": { "type": "string", "minLength": 1 },
				"method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
				"path": { "type": "string", "format": "starts_with", "pattern": "^\\/.*" },
				"class": { "type": "string", "enum": ["safe", "rebuild", "stateful"] },
				"auth": {
					"type": "string",
					"enum": ["owner-token", "management-key", "assertion", "session", "none"]
				}
			},
			"required": ["id", "method", "path", "class", "auth"],
			"additionalProperties": false
		},
		"discoveryDocument": {
			"type": "object",
			"properties": {
				"v": { "type": "number", "const": 1 },
				"kind": {
					"type": "string",
					"enum": ["drupal", "nuxtpress", "smoke", "mylora", "custom"]
				},
				"version": { "type": "string", "minLength": 1 },
				"releaseId": { "type": "string", "minLength": 1 },
				"schemaVersion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
				"capabilities": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": { "type": "string", "minLength": 1 },
							"state": {
								"type": "string",
								"enum": ["enabled", "disabled", "unavailable", "degraded"]
							},
							"reason": { "type": ["string", "null"] }
						},
						"required": ["id", "state", "reason"],
						"additionalProperties": false
					}
				},
				"settings": {
					"type": "object",
					"properties": {
						"schema": {
							"type": "object",
							"propertyNames": { "type": "string" },
							"additionalProperties": {}
						},
						"values": {
							"type": "object",
							"propertyNames": { "type": "string" },
							"additionalProperties": {}
						},
						"provenance": {
							"type": "object",
							"propertyNames": { "type": "string" },
							"additionalProperties": {
								"type": "string",
								"enum": ["default", "var", "kv", "override"]
							}
						},
						"writable": {
							"type": "object",
							"propertyNames": { "type": "string" },
							"additionalProperties": {
								"type": "string",
								"enum": ["var", "kv", "override"]
							}
						},
						"etag": { "type": "string", "minLength": 1 }
					},
					"required": ["schema", "values", "provenance", "writable", "etag"],
					"additionalProperties": false
				},
				"routes": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": { "type": "string", "minLength": 1 },
							"method": {
								"type": "string",
								"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
							},
							"path": {
								"type": "string",
								"format": "starts_with",
								"pattern": "^\\/.*"
							},
							"class": { "type": "string", "enum": ["safe", "rebuild", "stateful"] },
							"auth": {
								"type": "string",
								"enum": [
									"owner-token",
									"management-key",
									"assertion",
									"session",
									"none"
								]
							}
						},
						"required": ["id", "method", "path", "class", "auth"],
						"additionalProperties": false
					}
				},
				"redirects": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"from": {
								"type": "string",
								"format": "starts_with",
								"pattern": "^\\/.*"
							},
							"to": { "type": "string", "format": "starts_with", "pattern": "^\\/.*" }
						},
						"required": ["from", "to"],
						"additionalProperties": false
					}
				},
				"healthVocabulary": {
					"type": "array",
					"items": { "type": "string", "minLength": 1 }
				},
				"limits": {
					"type": "object",
					"propertyNames": { "type": "string" },
					"additionalProperties": { "type": "number" }
				}
			},
			"required": [
				"v",
				"kind",
				"version",
				"releaseId",
				"schemaVersion",
				"capabilities",
				"settings",
				"routes",
				"redirects",
				"healthVocabulary",
				"limits"
			],
			"additionalProperties": false
		}
	}
}
