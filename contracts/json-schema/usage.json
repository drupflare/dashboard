{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"contract": "usage",
	"version": "1.0",
	"schemas": {
		"usageInterval": {
			"type": "object",
			"properties": {
				"siteId": { "type": "string", "pattern": "^site_[0-9a-z]{8,40}$" },
				"start": {
					"type": "string",
					"format": "date-time",
					"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
				},
				"end": {
					"type": "string",
					"format": "date-time",
					"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
				},
				"accuracy": { "type": "string", "enum": ["exact", "estimated", "unaccounted"] },
				"views": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
				"lowerBound": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
				"observedViews": {
					"anyOf": [
						{ "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
						{ "type": "null" }
					]
				},
				"settlement": {
					"type": "string",
					"enum": ["open", "closed", "invoiced", "adjusted"]
				}
			},
			"required": [
				"siteId",
				"start",
				"end",
				"accuracy",
				"views",
				"lowerBound",
				"observedViews",
				"settlement"
			],
			"additionalProperties": false
		},
		"usageReport": {
			"type": "object",
			"properties": {
				"reportId": { "type": "string", "minLength": 8, "maxLength": 64 },
				"source": { "type": "string", "enum": ["dispatch", "worker", "node"] },
