					"format": "date-time",
					"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
				},
				"intervals": {
					"minItems": 1,
					"maxItems": 1000,
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"siteId": { "type": "string", "pattern": "^site_[0-9a-z]{8,40}$" },
							"start": {
								"type": "string",
								"format": "date-time",
								"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
							},
							"end": {
								"type": "string",
								"format": "date-time",
								"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
							},
							"accuracy": {
								"type": "string",
								"enum": ["exact", "estimated", "unaccounted"]
							},
							"views": {
								"type": "integer",
								"minimum": 0,
								"maximum": 9007199254740991
							},
							"lowerBound": {
								"type": "integer",
								"minimum": 0,
								"maximum": 9007199254740991
							},
							"observedViews": {
								"anyOf": [
									{
										"type": "integer",
										"minimum": 0,
										"maximum": 9007199254740991
									},
									{ "type": "null" }
								]
							},
							"settlement": {
								"type": "string",
								"enum": ["open", "closed", "invoiced", "adjusted"]
							}
						},
						"required": [
							"siteId",
							"start",
							"end",
							"accuracy",
							"views",
							"lowerBound",
							"observedViews",
							"settlement"
						],
						"additionalProperties": false
					}
				}
			},
			"required": ["reportId", "source", "sentAt", "intervals"],
			"additionalProperties": false
		},
		"usageAdjustment": {
			"type": "object",
			"properties": {
				"id": { "type": "string", "minLength": 8, "maxLength": 64 },
				"siteId": { "type": "string", "pattern": "^site_[0-9a-z]{8,40}$" },
				"intervalStart": {
					"type": "string",
					"format": "date-time",
					"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
				},
				"delta": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"reason": { "type": "string", "minLength": 1, "maxLength": 500 },
				"invoiceRef": { "type": ["string", "null"] },
				"at": {
					"type": "string",
					"format": "date-time",
					"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
				}
			},
			"required": ["id", "siteId", "intervalStart", "delta", "reason", "invoiceRef", "at"],
			"additionalProperties": false
		}
	}
}
