{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"contract": "gate-assertion",
	"version": "1.0",
	"schemas": {
		"gateAssertion": {
			"type": "object",
			"properties": {
				"v": { "type": "number", "const": 1 },
				"id": { "type": "string", "minLength": 16, "maxLength": 64 },
				"siteId": { "type": "string", "pattern": "^site_[0-9a-z]{8,40}$" },
				"environment": { "type": "string", "minLength": 1, "maxLength": 64 },
				"ruleHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
				"sub": { "type": "string", "minLength": 1, "maxLength": 256 },
				"iat": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
				"exp": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
				"sig": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
			},
			"required": [
				"v",
				"id",
				"siteId",
				"environment",
				"ruleHash",
				"sub",
				"iat",
				"exp",
				"sig"
			],
			"additionalProperties": false
		}
	}
}
