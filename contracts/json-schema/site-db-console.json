{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"contract": "site-db-console",
	"version": "1.0",
	"schemas": {
		"consoleRequest": {
			"type": "object",
			"properties": {
				"v": { "type": "number", "const": 1 },
				"siteId": { "type": "string", "pattern": "^site_[0-9a-z]{8,40}$" },
				"sql": { "type": "string", "minLength": 1, "maxLength": 10000 },
				"params": {
					"maxItems": 100,
					"type": "array",
					"items": { "type": ["string", "number", "boolean", "null"] }
				},
				"limit": { "type": "integer", "exclusiveMinimum": 0, "maximum": 1000 },
				"timeoutMs": { "type": "integer", "exclusiveMinimum": 0, "maximum": 30000 }
			},
			"required": ["v", "siteId", "sql", "params", "limit", "timeoutMs"],
			"additionalProperties": false
		},
		"consoleResponse": {
			"type": "object",
			"properties": {
				"columns": { "type": "array", "items": { "type": "string" } },
				"rows": {
					"maxItems": 1000,
					"type": "array",
					"items": {
						"type": "array",
						"items": { "type": ["string", "number", "boolean", "null"] }
					}
				},
				"truncated": { "type": "boolean" },
				"elapsedMs": { "type": "number", "minimum": 0 }
			},
			"required": ["columns", "rows", "truncated", "elapsedMs"],
			"additionalProperties": false
		},
		"consoleRefusal": {
			"type": "object",
			"properties": {
				"code": {
					"type": "string",
					"enum": ["not_read_only", "timeout", "too_large", "unavailable"]
				},
				"message": { "type": "string" }
			},
			"required": ["code", "message"],
			"additionalProperties": false
		}
	}
}
