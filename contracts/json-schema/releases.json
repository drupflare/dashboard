{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"contract": "releases",
	"version": "1.0",
	"schemas": {
		"releaseManifest": {
			"type": "object",
			"properties": {
				"kind": { "type": "string", "enum": ["worker", "php", "drupal-pack"] },
				"version": { "type": "string", "minLength": 1, "maxLength": 64 },
				"schemaVersion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
				"acceptsSchema": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
				"assets": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"name": { "type": "string", "minLength": 1, "maxLength": 200 },
							"url": { "type": "string", "format": "uri" },
							"digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
						},
						"required": ["name", "url", "digest"],
						"additionalProperties": false
					}
				}
			},
			"required": ["kind", "version", "schemaVersion", "acceptsSchema", "assets"],
			"additionalProperties": false
		},
		"releaseEvent": {
			"type": "object",
			"properties": {
				"v": { "type": "number", "const": 1 },
				"id": { "type": "string", "minLength": 8, "maxLength": 64 },
				"type": {
					"type": "string",
					"enum": ["release.published", "interpreter.published"]
				},
				"kind": { "type": "string", "enum": ["worker", "php", "drupal-pack"] },
				"version": { "type": "string", "minLength": 1, "maxLength": 64 },
				"manifestDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
				"manifestUrl": { "type": "string", "format": "uri" },
				"schemaVersion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
				"acceptsSchema": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
				"publishedAt": {
					"type": "string",
					"format": "date-time",
					"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
				},
				"advisoryAt": {
					"anyOf": [
						{
							"type": "string",
							"format": "date-time",
							"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
						},
						{ "type": "null" }
					]
				}
			},
			"required": [
				"v",
				"id",
				"type",
				"kind",
				"version",
				"manifestDigest",
				"manifestUrl",
				"schemaVersion",
				"acceptsSchema",
				"publishedAt",
				"advisoryAt"
			],
			"additionalProperties": false
		}
	}
}
