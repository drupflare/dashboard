{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"contract": "operations",
	"version": "1.1",
	"schemas": {
		"changeBudget": {
			"type": "object",
			"properties": {
				"maxDestructiveSites": {
					"type": "integer",
					"exclusiveMinimum": 0,
					"maximum": 9007199254740991
				},
				"maxConcurrentProductionDeploys": {
					"type": "integer",
					"exclusiveMinimum": 0,
					"maximum": 9007199254740991
				},
				"elevated": { "type": "boolean" },
				"bulkDeleteConfirmation": { "type": ["string", "null"] }
			},
			"required": [
				"maxDestructiveSites",
				"maxConcurrentProductionDeploys",
				"elevated",
				"bulkDeleteConfirmation"
			],
			"additionalProperties": false
		},
		"plan": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"enum": [
						"site.create",
						"site.adopt",
						"site.import",
						"import.survey",
						"migration.cutover",
						"estate.assess",
						"site.upgrade",
						"site.rollback",
						"site.delete",
						"site.restore",
						"site.purge",
						"site.transfer",
						"config.apply",
						"git.pull",
						"git.preview",
						"modify.apply",
						"module.install",
						"module.enable",
						"domain.attach",
						"backup.create",
						"backup.verify",
						"backup.restore",
						"backup.export",
						"env.create",
						"env.fork",
						"env.promote",
						"env.delete",
						"preview.create",
						"preview.delete",
						"repair.run",
						"node.pair",
						"node.command",
						"fleet.upgrade",
						"repo.install"
					]
				},
				"targetIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
				"preconditions": { "type": "array", "items": { "type": "string" } },
				"steps": {
					"minItems": 1,
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": { "type": "string", "minLength": 1, "maxLength": 64 },
							"name": { "type": "string", "minLength": 1, "maxLength": 200 }
						},
						"required": ["id", "name"],
						"additionalProperties": false
					}
				},
				"blastRadius": {
					"type": "object",
					"properties": {
						"sites": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
						"destructiveSites": {
							"type": "integer",
							"minimum": 0,
							"maximum": 9007199254740991
						},
						"productionDeploys": {
							"type": "integer",
							"minimum": 0,
							"maximum": 9007199254740991
						}
					},
					"required": ["sites", "destructiveSites", "productionDeploys"],
					"additionalProperties": false
				},
				"rollbackPoint": { "type": ["string", "null"] }
			},
			"required": [
				"type",
				"targetIds",
				"preconditions",
				"steps",
				"blastRadius",
				"rollbackPoint"
			],
			"additionalProperties": false
		},
		"step": {
			"type": "object",
			"properties": {
				"id": { "type": "string", "minLength": 1, "maxLength": 64 },
				"name": { "type": "string", "minLength": 1, "maxLength": 200 },
				"state": {
					"type": "string",
					"enum": ["pending", "running", "succeeded", "failed", "skipped"]
				},
				"attempt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
				"startedAt": {
					"anyOf": [
						{
							"type": "string",
							"format": "date-time",
							"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
						},
						{ "type": "null" }
					]
				},
				"finishedAt": {
					"anyOf": [
						{
							"type": "string",
							"format": "date-time",
							"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
						},
						{ "type": "null" }
					]
				},
				"error": { "type": ["string", "null"] }
			},
			"required": ["id", "name", "state", "attempt", "startedAt", "finishedAt", "error"],
			"additionalProperties": false
		},
		"operation": {
			"type": "object",
			"properties": {
				"id": { "type": "string", "pattern": "^op_[0-9a-z]{8,40}$" },
				"orgId": { "type": "string", "pattern": "^org_[0-9a-z]{8,40}$" },
				"type": {
					"type": "string",
					"enum": [
						"site.create",
						"site.adopt",
						"site.import",
						"import.survey",
						"migration.cutover",
						"estate.assess",
						"site.upgrade",
						"site.rollback",
						"site.delete",
						"site.restore",
						"site.purge",
						"site.transfer",
						"config.apply",
						"git.pull",
						"git.preview",
						"modify.apply",
						"module.install",
						"module.enable",
						"domain.attach",
						"backup.create",
						"backup.verify",
						"backup.restore",
						"backup.export",
						"env.create",
						"env.fork",
						"env.promote",
						"env.delete",
						"preview.create",
						"preview.delete",
						"repair.run",
						"node.pair",
						"node.command",
						"fleet.upgrade",
						"repo.install"
					]
				},
				"status": {
					"type": "string",
					"enum": [
						"planned",
						"awaiting-approval",
						"running",
						"verifying",
						"succeeded",
						"failed",
						"cancelled",
						"rolled-back"
					]
				},
				"idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 },
				"targetIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
				"preconditions": { "type": "array", "items": { "type": "string" } },
				"planDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
				"fencingEpoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
				"blastRadius": {
					"type": "object",
					"properties": {
						"sites": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
						"destructiveSites": {
							"type": "integer",
							"minimum": 0,
							"maximum": 9007199254740991
						},
						"productionDeploys": {
							"type": "integer",
							"minimum": 0,
							"maximum": 9007199254740991
						}
					},
					"required": ["sites", "destructiveSites", "productionDeploys"],
					"additionalProperties": false
				},
				"rollbackPoint": { "type": ["string", "null"] },
				"cursor": { "type": ["string", "null"] },
				"steps": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": { "type": "string", "minLength": 1, "maxLength": 64 },
							"name": { "type": "string", "minLength": 1, "maxLength": 200 },
							"state": {
								"type": "string",
								"enum": ["pending", "running", "succeeded", "failed", "skipped"]
							},
							"attempt": {
								"type": "integer",
								"minimum": 0,
								"maximum": 9007199254740991
							},
							"startedAt": {
								"anyOf": [
									{
										"type": "string",
										"format": "date-time",
										"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
									},
									{ "type": "null" }
								]
							},
							"finishedAt": {
								"anyOf": [
									{
										"type": "string",
										"format": "date-time",
										"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
									},
									{ "type": "null" }
								]
							},
							"error": { "type": ["string", "null"] }
						},
						"required": [
							"id",
							"name",
							"state",
							"attempt",
							"startedAt",
							"finishedAt",
							"error"
						],
						"additionalProperties": false
					}
				},
				"verification": {
					"type": "string",
					"enum": ["pending", "passed", "failed", "not-required"]
				},
				"finalObservation": {
					"anyOf": [
						{
							"type": "object",
							"properties": {
								"at": {
									"type": "string",
									"format": "date-time",
									"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
								},
								"summary": { "type": "string" }
							},
							"required": ["at", "summary"],
							"additionalProperties": false
						},
						{ "type": "null" }
					]
				},
				"budget": {
					"type": "object",
					"properties": {
						"maxDestructiveSites": {
							"type": "integer",
							"exclusiveMinimum": 0,
							"maximum": 9007199254740991
						},
						"maxConcurrentProductionDeploys": {
							"type": "integer",
							"exclusiveMinimum": 0,
							"maximum": 9007199254740991
						},
						"elevated": { "type": "boolean" },
						"bulkDeleteConfirmation": { "type": ["string", "null"] }
					},
					"required": [
						"maxDestructiveSites",
						"maxConcurrentProductionDeploys",
						"elevated",
						"bulkDeleteConfirmation"
					],
					"additionalProperties": false
				},
				"retryOf": {
					"anyOf": [
						{ "type": "string", "pattern": "^op_[0-9a-z]{8,40}$" },
						{ "type": "null" }
					]
				},
				"createdAt": {
					"type": "string",
					"format": "date-time",
					"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time",
					"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
				}
			},
			"required": [
				"id",
				"orgId",
				"type",
				"status",
				"idempotencyKey",
				"targetIds",
				"preconditions",
				"planDigest",
				"fencingEpoch",
				"blastRadius",
				"rollbackPoint",
				"cursor",
				"steps",
				"verification",
				"finalObservation",
				"budget",
				"createdAt",
				"updatedAt"
			],
			"additionalProperties": false
		}
	}
}
