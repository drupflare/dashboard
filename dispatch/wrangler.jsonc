{
	"name": "drupflare-dispatch",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"dispatch_namespaces": [{ "binding": "DISPATCH", "namespace": "drupflare-prod" }],
	"kv_namespaces": [{ "binding": "HOSTS_KV" }],
	"analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "drupflare_usage" }],
	"durable_objects": {
		"bindings": [
			{ "name": "SITE_AUTH", "class_name": "SiteAuth" },
			{ "name": "NAMES", "class_name": "Names" },
			{ "name": "USAGE_COUNTER", "class_name": "UsageCounter" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["SiteAuth", "Names"] },
		{ "tag": "v2", "new_sqlite_classes": ["UsageCounter"] }
	],
	"env": {
		"stage": {
			"name": "drupflare-dispatch-stage",
			"vars": { "SPIKE_MODE": "1" },
			"dispatch_namespaces": [{ "binding": "DISPATCH", "namespace": "drupflare-stage" }],
			"kv_namespaces": [{ "binding": "HOSTS_KV" }],
			"analytics_engine_datasets": [
				{ "binding": "USAGE", "dataset": "drupflare_usage_stage" }
			],
			"durable_objects": {
				"bindings": [
					{ "name": "SITE_AUTH", "class_name": "SiteAuth" },
					{ "name": "NAMES", "class_name": "Names" },
					{ "name": "USAGE_COUNTER", "class_name": "UsageCounter" }
				]
			},
			"migrations": [
				{ "tag": "v1", "new_sqlite_classes": ["SiteAuth", "Names"] },
				{ "tag": "v2", "new_sqlite_classes": ["UsageCounter"] }
			]
		}
	}
}
