{
	"name": "drupflare-dashboard",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true, "head_sampling_rate": 1.0 },
	"d1_databases": [{ "binding": "DB", "database_name": "drupflare-dashboard-db" }],
	"kv_namespaces": [{ "binding": "KV" }, { "binding": "CACHE" }, { "binding": "HOSTS_KV" }],
	"r2_buckets": [{ "binding": "BLOB", "bucket_name": "drupflare-dashboard-blob" }]
}
